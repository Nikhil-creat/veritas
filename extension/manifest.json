{
  "manifest_version": 3,
  "name": "Veritas — Check Image Authenticity",
  "version": "0.1.0",
  "description": "Right-click any image on the web and run it through Veritas's authenticity checks.",
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
